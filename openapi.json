  "components": {
    "schemas": {
      "OrdenTrabajoRequest": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "integer",
            "format": "int64",
            "description": "Obligatorio para origin PROYECTO; debe omitirse para los demas origenes"
          },
          "sourceRequestId": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "origin": {
            "type": "string",
            "enum": [
              "MANUAL",
              "PROYECTO",
              "ATENCION_CIUDADANA",
              "INSPECCION"
            ],
            "minLength": 1
          },
          "description": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 0
          },
          "interventionType": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "location": {
            "type": "string",
            "maxLength": 300,
            "minLength": 0
          },
          "priority": {
            "type": "string",
            "minLength": 1
          },
          "estimatedDurationHours": {
            "type": "integer",
            "format": "int32"
          },
          "crew": {
            "type": "string"
          }
        },
        "required": [
          "description",
          "origin",
          "priority"
        ]
      },
      "OrdenTrabajoResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "sourceRequestId": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "interventionType": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "crew": {
            "type": "string"
          },
          "scheduledDate": {
            "type": "string",
            "format": "date"
          },
          "estimatedDurationHours": {
            "type": "integer",
            "format": "int32"
          },
          "hasEvidence": {
            "type": "boolean"
          },
          "outcome": {
            "type": "string"
          },
          "projectId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ProyectoObraRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "estimatedBudget": {
            "type": "number",
            "minimum": 0.0
          },
          "approvedBudget": {
            "type": "number",
            "minimum": 0.0
          },
          "usedBudget": {
            "type": "number",
            "minimum": 0.0
          },
          "estimatedStartDate": {
            "type": "string",
            "format": "date"
          },
          "estimatedDurationDays": {
            "type": "integer",
            "format": "int32"
          },
          "approvedDeadlineDays": {
            "type": "integer",
            "format": "int32"
