# Documentation only: Spring Boot does not load .env automatically.
# Export these values in your shell/IDE or use docker run --env-file .env.
DB_URL=jdbc:postgresql://localhost:5432/obras_publicas
DB_USERNAME=postgres
DB_PASSWORD=replace-with-local-password
# Authentication values must be injected by the local developer or DevOps.
# JWT_SECRET must contain at least 32 characters.
JWT_SECRET=replace-with-a-local-secret-of-at-least-32-characters
# Optional legacy bootstrap; existing accounts are never overwritten.
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_ROLE=PERSONAL_OBRAS
# Optional JSON array of {username,password,role}, injected as a secret.
AUTH_BOOTSTRAP_USERS=[]
JWT_EXPIRATION_MINUTES=480
# Optional application settings
PORT=8080
SERVER_PORT=8080
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=0
DB_CONNECTION_TIMEOUT_MS=10000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_DEMO_ENABLED=false
# Only for a disposable PostgreSQL test database, never Azure or shared data
TEST_DB_URL=jdbc:postgresql://localhost:55432/obras_migration_test
TEST_DB_USERNAME=postgres
TEST_DB_PASSWORD=replace-with-test-password
# Keep disabled until private AMQPS credentials and outbound IP allowlisting are ready.
MESSAGING_ENABLED=false
# Enable only after M6 accepts the UUID workOrderId contract from M3 v0.6.
M6_UUID_CONTRACT_CONFIRMED=false
M7_UUID_CONTRACT_CONFIRMED=false
# Provisional: keep false until M7 confirms accidentId as UUID.
M7_ACCIDENT_UUID_REQUIRED=false
CORE_MODULE_NAME=obras
CORE_EXCHANGE=muni.inbox
CORE_QUEUE=q.obras
RABBITMQ_HOST=core-uade-2026.duckdns.org
RABBITMQ_USERNAME=module_obras
RABBITMQ_PORT=5671
RABBITMQ_VHOST=core
RABBITMQ_TLS_ENABLED=true
# Supply RABBITMQ_PASSWORD privately; HTTP tokens never authenticate RabbitMQ.
# CORE_BASE_URL and CORE_MACHINE_SECRET are HTTP-only configuration.
# HTTP client pending the complete response/error contract.
