# Documentation only: Spring Boot does not load .env automatically.
# Export these values in your shell/IDE or use docker run --env-file .env.
DB_URL=jdbc:postgresql://localhost:5432/obras_publicas
DB_USERNAME=postgres
DB_PASSWORD=replace-with-local-password
# Optional application settings
PORT=8080
SERVER_PORT=8080
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=0
DB_CONNECTION_TIMEOUT_MS=10000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_DEMO_ENABLED=false
# Only for a disposable PostgreSQL test database, never Azure or shared data
TEST_DB_URL=jdbc:postgresql://localhost:55432/obras_migration_test
TEST_DB_USERNAME=postgres
TEST_DB_PASSWORD=replace-with-test-password
