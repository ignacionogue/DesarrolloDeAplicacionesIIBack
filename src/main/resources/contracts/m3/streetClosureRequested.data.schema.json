{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uade.m3.obras/eventos/streetClosureRequested.data.schema.json",
  "title": "streetClosureRequested data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "closureRequestId", "sourceModule", "sourceRef", "reason", "affectedSections",
    "requestedFrom", "requestedTo", "closureType", "requestedAt"
  ],
  "properties": {
    "closureRequestId": {"type": "string", "format": "uuid"},
    "sourceModule": {"const": "obras"},
    "sourceRef": {"type": "string", "format": "uuid"},
    "reason": {"type": "string", "minLength": 1},
    "affectedSections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["street", "from", "to", "direction"],
        "properties": {
          "street": {"type": "string", "minLength": 1},
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "direction": {"enum": ["FORWARD", "REVERSE", "BOTH"]}
        }
      }
    },
    "requestedFrom": {"type": "string", "format": "date-time"},
    "requestedTo": {"type": "string", "format": "date-time"},
    "closureType": {"type": "string", "minLength": 1},
    "requestedAt": {"type": "string", "format": "date-time"},
    "previousClosureRequestId": {"type": "string", "format": "uuid"}
  }
}
