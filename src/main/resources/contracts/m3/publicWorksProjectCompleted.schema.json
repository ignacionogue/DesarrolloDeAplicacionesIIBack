{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m3.obras/contracts/publicWorksProjectCompleted.schema.json",
  "title": "publicWorksProjectCompleted event v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "sourceModule", "correlationId", "data"],
  "properties": {
    "eventId": {"type": "string", "format": "uuid"},
    "eventType": {"const": "publicWorksProjectCompleted"},
    "eventVersion": {"const": "1.0"},
    "occurredAt": {"type": "string", "format": "date-time"},
    "sourceModule": {"const": "obras"},
    "correlationId": {"type": "string", "format": "uuid"},
    "causationId": {"type": "string", "format": "uuid"},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicWorksProjectId", "projectNumber", "completedAt"],
      "properties": {
        "publicWorksProjectId": {"type": "string", "format": "uuid"},
        "projectNumber": {"type": "string", "minLength": 1, "maxLength": 80},
        "completedAt": {"type": "string", "format": "date-time"},
        "finalBudget": {"type": "number", "minimum": 0},
        "caseFileId": {"type": "string", "format": "uuid"}
      }
    }
  }
}
